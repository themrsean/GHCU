<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="grading.controller.FindBarController"
      spacing="6"
      fx:id="root"
      alignment="CENTER_LEFT"
      style="-fx-padding: 6; -fx-background-color: -fx-control-inner-background;">

    <TextField fx:id="findField"
               promptText="Find"
               prefWidth="160"/>
    <Label fx:id="matchLabel" text="0 / 0"/>
    <Button text="↑" onAction="#onPrevious"/>
    <Button text="↓" onAction="#onNext"/>

    <TextField fx:id="replaceField"
               promptText="Replace"
               prefWidth="160"/>

    <Button text="Replace" onAction="#onReplace"/>
    <Button text="Replace All" onAction="#onReplaceAll"/>

    <Button text="✕" onAction="#onClose"/>
</HBox>
